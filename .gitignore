# kemy_tools.py, kemy_agents.py) são versionados; o kemy_config.py (que tem a chave
# hardcoded) e o zip (que embala tudo) NÃO.
projetos/KEMY_AI/kemy_config.py
projetos/KEMY_AI.zip
projetos/KEMY_AI/.env
