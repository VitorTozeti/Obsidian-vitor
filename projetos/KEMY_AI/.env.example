KEMY_API_KEY=coloque_sua_chave_do_openrouter_aqui
KEMY_MODEL=inclusionai/ling-3.0-flash-fin:free
# Modelo padrao ja e GRATUITO no OpenRouter (evita gastos).
# Compatibilidade: OPENROUTER_API_KEY, ou as antigas GROK_API_KEY / GROK_MODEL,
# tambem funcionam como fallback da chave/modelo.

# Se o modelo acima ficar sem tokens/credito/limite (402/429/quota), a K.E.M.Y
# troca sozinha para o proximo desta lista (separada por virgula). Padrao (se
# nao definir) ja inclui inclusionai/ling-3.0-flash-fin:free e
# inclusionai/ling-3.0-flash-vl:free.
# KEMY_MODEL_FALLBACKS=inclusionai/ling-3.0-flash-fin:free,inclusionai/ling-3.0-flash-vl:free
