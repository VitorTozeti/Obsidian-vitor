# ---- Chave e modelo (OpenRouter) ----
KEMY_API_KEY=coloque_sua_chave_do_openrouter_aqui
KEMY_MODEL=inclusionai/ling-3.0-flash-fin:free
# Modelo padrao ja e GRATUITO (evita gastos). Fallback aceito: OPENROUTER_API_KEY,
# GROK_API_KEY / GROK_MODEL. Se o modelo esgotar token/credito, troca sozinha para:
# KEMY_MODEL_FALLBACKS=inclusionai/ling-3.0-flash-fin:free,inclusionai/ling-3.0-flash-vl:free

# ---- Fallback sem ferramentas: Cohere / Replicate ----
# So entra quando TODOS os modelos da fila da OpenRouter esgotam (402/429/quota).
# Nao suporta tool-calling (ler/escrever arquivo, web, e-mail) — so responde texto.
# Precisa de pelo menos uma das duas chaves; se tiver as duas, tenta Cohere primeiro.
COHERE_API_KEY=
# COHERE_MODEL=command-r
REPLICATE_API_TOKEN=
# REPLICATE_MODEL=meta/meta-llama-3-8b-instruct

# ---- Modo (automatico x seguro) ----
# 0 = automatico (sem confirmacoes). 1 = seguro (pede OK antes de escrever/rodar/
# editar/sair pra web). Troca a quente no chat com /auto e /seguro. E-mail SEMPRE confirma.
KEMY_CONFIRM=0

# ---- E-mail (envio pela sua conta; sempre mostra e pede confirmacao) ----
KEMY_EMAIL_FROM=vitortozeti@gmail.com
# Senha de APP do Gmail (NAO a senha normal): https://myaccount.google.com/apppasswords
KEMY_EMAIL_APP_PASSWORD=
# KEMY_SMTP_HOST=smtp.gmail.com
# KEMY_SMTP_PORT=587

# ---- Caminhos ----
# Vault do Obsidian com seus projetos (conexao direta).
KEMY_OBSIDIAN_VAULT=C:\Users\v.tozeti\Desktop\Vitor\teste\Obsidian-vitor
# Hub de dados da propria K.E.M.Y (historico, memoria de pastas). Padrao: ~/.kemy
# KEMY_HOME=C:\Users\v.tozeti\.kemy

# ---- Busca no disco ----
# KEMY_SEARCH_MAX_RESULTS=200
# KEMY_SEARCH_MAX_DEPTH=8
